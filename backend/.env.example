# ============================================================
# English Learning Platform · 后端环境变量样例
# 使用时复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会入库）
# ============================================================

# ---------- 服务 ----------
PORT=4000
NODE_ENV=development

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=english_platform

# 连接池
DB_POOL_LIMIT=10

# ---------- 业务 ----------
# 第一阶段为单用户；接口未传 studentId 时使用该学生
DEFAULT_STUDENT_NAME=Zane
