{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-study.local/schemas/v1/lesson-record.schema.json",
  "title": "LessonRecord 课程归档记录",
  "description": "daily-lesson 归档一步的产物，对应 backend POST /api/lessons（新建）与 PUT /api/lessons/:id（回填批改与反馈）。一节课只产出一个本对象；笔记 md 是本对象的一种落地形式，不是真相源。",
  "type": "object",
  "required": ["lessonNo", "levelCode", "summary", "sections"],
  "$defs": {
    "SectionContent": {
      "description": "一个小节的原始 Markdown 正文。标题文字由 section_type 决定，Skill 不得改动标题。",
      "type": "object",
      "required": ["sectionType", "contentMd"],
      "properties": {
        "sectionType": { "$ref": "common.schema.json#/$defs/SectionType" },
        "contentMd": { "type": "string", "minLength": 1 },
        "orderIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "VocabularyEntry": {
      "description": "本课词表条目，对应 vocabulary + lesson_vocabulary。word 在用户内唯一，已出现过的词只更新例句。",
      "type": "object",
      "required": ["word", "isNew"],
      "properties": {
        "word": { "type": "string", "minLength": 1, "maxLength": 64 },
        "phonetic": { "type": "string" },
        "meaning": { "type": "string" },
        "example": { "type": "string", "description": "本课例句，用本课语法点写。" },
        "isNew": { "type": "boolean", "description": "本课是否首次出现，对应 lesson_vocabulary.is_new。" },
        "orderIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "ExerciseRecord": {
      "description": "一道作业题及其批改结果，对应 exercises 表一行。批改结论在回填阶段写入。",
      "type": "object",
      "required": ["exerciseNo", "exerciseType", "prompt"],
      "properties": {
        "exerciseNo": { "type": "integer", "minimum": 1 },
        "exerciseType": { "$ref": "common.schema.json#/$defs/ExerciseType" },
        "prompt": { "type": "string" },
        "referenceAnswer": { "type": "string" },
        "userAnswer": { "type": ["string", "null"] },
        "isCorrect": {
          "type": ["boolean", "null"],
          "description": "批改结论的唯一对外字段名（对应 lesson_exercises.is_correct）。true=对，false=错，null=未批改或未作答。禁止新增 verified / verdict 一类同义字段；Skill 内部的四态判定见 grading-result.schema.json 的 GradedItem.verdict，归档时按该处映射规则转换。"
        },
        "revisedAnswer": {
          "description": "开放题的完整改后版（学生整段作答的修正），对应 lesson_exercises.revised_answer。与 referenceAnswer（题目标准答案）语义不同：前者是「这个学生应该怎么写」，后者是「标准答案」。两者都保留，不得合并；非开放题为 null。",
          "type": ["string", "null"]
        },
        "errorNote": { "type": ["string", "null"] },
        "targetPoint": { "type": "string", "description": "本题考核的知识点代码。" }
      }
    }
  },
  "properties": {
    "lessonNo": { "type": "integer", "minimum": 1 },
    "lessonDate": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/DateOnly" }, { "type": "null" }]
    },
    "levelCode": { "$ref": "common.schema.json#/$defs/LevelCode" },
    "summary": { "type": "string", "maxLength": 255 },
    "studyMinutes": {
      "description": "本课学习时长，对应 courses.study_minutes。按上下课时间差估算，由 daily-lesson 归档时填入。",
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 240
    },
    "sourceFile": {
      "type": "string",
      "pattern": "^day-[0-9]{2}-[0-9]{2}\\.md$"
    },
    "status": { "type": "string", "enum": ["planned", "taught", "archived"] },
    "sections": {
      "description": "小节集合。review / grammar / examples / homework / my_answer / grading / feedback 为必填；objectives 与 expected_mistakes 为 S1 已落库的可选小节（2026-09-29，D-10 批准），每个课次各最多一条。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SectionContent" }
    },
    "vocabulary": {
      "type": "array",
      "items": { "$ref": "#/$defs/VocabularyEntry" }
    },
    "exercises": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExerciseRecord" }
    },
    "knowledgePoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "role"],
        "properties": {
          "code": { "type": "string" },
          "role": { "$ref": "common.schema.json#/$defs/KnowledgeRole" }
        }
      }
    },
    "feedback": {
      "description": "本课难度反馈结果，对应 POST /api/progress/feedback 的响应。",
      "type": "object",
      "required": ["feedback", "levelBefore", "levelAfter"],
      "properties": {
        "feedback": { "$ref": "common.schema.json#/$defs/Feedback" },
        "levelBefore": { "$ref": "common.schema.json#/$defs/LevelCode" },
        "levelAfter": { "$ref": "common.schema.json#/$defs/LevelCode" },
        "easyStreak": { "type": "integer", "minimum": 0 },
        "upgradeFrozenUntil": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "gradeSummary": {
      "description": "批改汇总，对应 study_records(record_type='grade').payload。口径固定为作业错误处数，不折算百分制。",
      "type": "object",
      "required": ["exerciseCount", "errorCount"],
      "properties": {
        "exerciseCount": { "type": "integer", "minimum": 0 },
        "errorCount": { "type": "integer", "minimum": 0 },
        "byType": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "newMistakes": { "type": "integer", "minimum": 0 },
        "passedMistakes": { "type": "integer", "minimum": 0 }
      }
    },
    "nextRecommendation": {
      "description": "下一课计划文本，对应 study_records(record_type='feedback').payload.next_recommendation。写下它才能让每天的教学决策可回溯。",
      "type": "string"
    },
    "skillRunIds": {
      "description": "本课涉及的 skill_runs 主键，便于从课程反查 Skill 侧决策。",
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
